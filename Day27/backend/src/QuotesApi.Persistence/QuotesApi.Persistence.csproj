<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuotesApi.Persistence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuotesApi.SharedKernel\QuotesApi.SharedKernel.csproj" />
    <ProjectReference Include="..\Modules\Quotes\QuotesApi.Quotes.Domain\QuotesApi.Quotes.Domain.csproj" />
    <ProjectReference Include="..\Modules\Identity\QuotesApi.Identity.Domain\QuotesApi.Identity.Domain.csproj" />
    <ProjectReference Include="..\Modules\Jobs\QuotesApi.Jobs.Domain\QuotesApi.Jobs.Domain.csproj" />
    <ProjectReference Include="..\Modules\Messaging\QuotesApi.Messaging.Domain\QuotesApi.Messaging.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="QuotesApi.SharedKernel" />
  </ItemGroup>

</Project>
