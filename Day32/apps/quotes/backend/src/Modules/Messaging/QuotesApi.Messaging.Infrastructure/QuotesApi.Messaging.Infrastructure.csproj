<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuotesApi.Messaging.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuotesApi.Messaging.Application\QuotesApi.Messaging.Application.csproj" />
    <ProjectReference Include="..\..\..\QuotesApi.Persistence\QuotesApi.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="QuotesApi.SharedKernel" />
    <Using Include="QuotesApi.Messaging.Domain" />
    <Using Include="QuotesApi.Messaging.Contracts" />
    <Using Include="QuotesApi.Messaging.Application" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Azure.Identity arrives transitively via EntityFrameworkCore.SqlServer ->
      Microsoft.Data.SqlClient, which needs it at RUNTIME for Entra authentication to Azure SQL.
      But Azure.Core 1.60 already defines AzureCliCredential and DefaultAzureCredential, so
      referencing both at COMPILE time is CS0433, "the type exists in both".

      ExcludeAssets="compile" keeps the assembly in the output for SqlClient to load, and takes
      it out of the compiler's reference set so the names resolve to Azure.Core alone.
    -->
    <PackageReference Include="Azure.Identity" Version="1.17.1" ExcludeAssets="compile" />
  </ItemGroup>

</Project>
