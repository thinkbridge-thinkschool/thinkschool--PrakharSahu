# Copy this file to .env and fill in the real value. .env is gitignored and must
# never be committed -- it is the only place the password lives.
#
# The double underscore maps onto the configuration hierarchy, so this key lands
# at ConnectionStrings:DefaultConnection and GetConnectionString() picks it up.

ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=Day10_DB;User Id=sa;Password=<your-password>;TrustServerCertificate=True;Connection Timeout=60;"
